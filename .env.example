# Secrets + service endpoints. Loaded by Vite (dev) and docker compose (container).
# Leave any value empty to disable that feature — the app works fine without them.
OPENROUTER_API_KEY=sk-or-v1-0....wq
# Where map JSON files live (default: ./maps). The mindmap CLI sets this per project.
MAPS_DIR=
# HTTP port for the standalone server (default: 5454).
PORT=
REFINE_MODEL=deepseek/deepseek-v4-flash
TRANSCRIBER_URL=http://localhost:8124
SEGON_CERVELL_MCP_URL=http://localhost:8000/mcp
